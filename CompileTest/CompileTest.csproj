        <PackageReference Include="coverlet.collector" Version="3.1.2" />
    </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\FastExpressionCompiler\FastExpressionCompiler.csproj" />
  </ItemGroup>

</Project>
